    <module name="mist-restest-adapter" />
    <option name="PROGRAM_PARAMETERS" value="mist-restest-adapter/src/main/resources/My-Example/trainticket/merged_openapi_spec 1.yaml mist-restest-adapter/src/main/resources/My-Example/trainticket/real-system-conf.yaml" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="ALTERNATIVE_JRE_PATH_ENABLED" value="false" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
