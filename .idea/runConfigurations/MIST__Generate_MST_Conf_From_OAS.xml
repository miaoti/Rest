<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="MIST: Generate MST Conf From OAS" type="Application" factoryName="Application">
    <!-- One-time MST configuration generator. Reads an OpenAPI spec
         and writes the MST YAML that the demo's `conf.path` property
         points at. Takes two positional args: <input-oas> <output-conf>.
         Defaults below point at the bundled TrainTicket spec. Edit
         in IntelliJ "Edit Configurations…" for your own SUT. -->
    <option name="MAIN_CLASS_NAME" value="io.mist.cli.MistConfGenMain" />
    <module name="mist-cli" />
    <option name="PROGRAM_PARAMETERS" value="&quot;mist-restest-adapter/src/main/resources/My-Example/trainticket/merged_openapi_spec 1.yaml&quot; mist-restest-adapter/src/main/resources/My-Example/trainticket/real-system-conf.yaml" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="ALTERNATIVE_JRE_PATH_ENABLED" value="false" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
