public class UUIDValidationFilter implements GlobalFilter, Ordered {

    @Override
    public Mono<Void> filter(ServerWebExchange exchange, GatewayFilterChain chain) {
        String orderId = exchange.getRequest().getQueryParams().getFirst("orderId");
        if (orderId != null && !isValidUUID(orderId)) {
            return onError(exchange, "Invalid order ID format", HttpStatus.BAD_REQUEST);
        }
        return chain.filter(exchange);
    }

    private boolean isValidUUID(String uuid) {
        try {
