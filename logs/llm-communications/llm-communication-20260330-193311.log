public static UUID validateAndParseUUID(String uuidStr) {
    try {
        // Check if the string is a valid UUID
        Pattern uuidPattern = Pattern.compile("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$");
