llm-communication-20260505-225616.log,2641,2026-05-06 05:59:44.690,deepseek-chat,other,,,,,,,,,,,,3,Increase `order_id` column length in `ts.consign_record` table:
llm-communication-20260505-225616.log,2641,2026-05-06 05:59:44.690,deepseek-chat,other,,,,,,,,,,,,4,`ALTER TABLE ts.consign_record MODIFY order_id VARCHAR(512) NOT NULL;`
llm-communication-20260505-225616.log,2641,2026-05-06 05:59:44.690,deepseek-chat,other,,,,,,,,,,,,5,"(adjust length based on actual max order ID size, e.g., 512 or 1024)."
